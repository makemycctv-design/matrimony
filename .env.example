APP_NAME=Vivaaha
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_SUPPORTED_LOCALES=en,ml
APP_LEGAL_VERSION=1.0
APP_DELETION_GRACE_DAYS=14

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Local development can use sqlite. Production should use MySQL 8+.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=matrimony
# DB_USERNAME=matrimony
# DB_PASSWORD=

# --- Session / Cache / Queue ------------------------------------------------
# On shared hosting keep these on "database". With Redis available, switch
# SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (use log locally; configure SMTP in production) -------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS / OTP --------------------------------------------------------------
# "log" writes OTPs to the log (safe default). Configure a provider in prod.
SMS_DRIVER=log
SMS_FROM=VIVAAH
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# GUPSHUP_API_KEY=
# GUPSHUP_SOURCE=

# --- Razorpay (Phase 4). Server-side only — never expose the secret. --------
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Search (Scout). "database" needs no extra services. --------------------
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# --- AWS / S3 (optional, for private document storage at scale) -------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
